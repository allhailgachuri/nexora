{
  "name": "nexora",
  "version": "1.0.0",
  "description": "NEXORA - IoT Device Fleet Security & Anomaly Monitoring Platform",
  "main": "server/dist/index.js",
  "scripts": {
    "server": "node server/dist/index.js",
    "client": "vite client",
    "dev": "concurrently \"npm run dev:server\" \"npm run client\"",
    "dev:server": "ts-node server/src/index.ts",
    "build:client": "vite build client",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:server && npm run build:client",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "node-forge": "^1.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
